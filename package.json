    "generate-sdk": "cd packages/scripts && pnpm generate-sdk",
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "devDependencies": {
    "@tsconfig/node18": "^18.2.4",
    "@tsconfig/node20": "^20.1.4",
    "typescript": "5.6.2",
    "vitest": "^2.0.3"
  },
  "dependencies": {
    "@pulumi/aws": "^6.83.0",
    "@pulumi/pulumi": "^3.145.0",
    "@pulumi/tls": "^5.2.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.8",
    "archiver": "^7.0.1",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "effect": "^3.12.1",
    "helius-sdk": "^1.4.0",
    "square": "^39.1.1",
    "sst": "3.7.14",
    "tronweb": "^6.0.0"
  }
