{
  "name": "normietech",
  "version": "0.0.0",
  "packageManager": "pnpm@9.6.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm sst dev",
    "sso:dev": "aws sso login --profile=normie-tech-sandbox",
